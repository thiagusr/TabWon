TX_INDICADOR_NUMERADOR_DENOMINADOR_ESCALA_E = "Indicator = numerator ÷ denominator × scale. E.g.: deaths ÷ live births × 1,000 gives the rate per thousand. Choose the numerator column, the scale (per 1 up to per 1,000,000), the denominator column and the decimal places. In TOTAL, the indicator is recalculated with the totals of both columns."
TX_MINIMO                                   = "Minimum"
TX_MENOR_VALOR_ENTRE_AS_COLUNAS             = "Smallest value among the selected columns, calculated for each row."
TX_MAXIMO                                   = "Maximum"
TX_MAIOR_VALOR_ENTRE_AS_COLUNAS             = "Largest value among the selected columns, calculated for each row."
TX_POSICAO_RANKING                          = "Rank"
TX_POSICAO                                  = "Rank"
TX_CLASSIFICA_AS_LINHAS_PELO_VALOR          = "Ranks the rows by the column value: 1st for the largest (or the smallest, if you prefer). Tied values get the same rank."
TX_ESQUERDA                                 = "Left"
TX_PEGA_OS_PRIMEIROS_CARACTERES_OU          = "Takes the first characters or digits of a column. E.g.: the first 2 of \"430020\" give \"43\". Also works for the 1st column (the categories)."
TX_DIREITA                                  = "Right"
TX_PEGA_OS_ULTIMOS_CARACTERES_OU            = "Takes the last characters or digits of a column. E.g.: the last 4 of \"202609\" give \"2609\"."
TX_MEIO                                     = "Middle"
TX_PEGA_UM_TRECHO_DO_MEIO                   = "Takes a piece from the middle: from a position, a number of characters. E.g.: from the 3rd, 2 characters of \"202609\" give \"26\"."
TX_CONCATENAR                               = "Concatenate"
TX_CONCATENADO                              = "Concatenated"
TX_JUNTA_NA_ORDEM_QUE_VOCE                  = "Joins, in the order you define, the values of one or more columns and texts you type. E.g.: column City + \" - \" + column State gives \"Porto Alegre - RS\". It also joins a column with fixed text, such as \"R$ \" before the value."
