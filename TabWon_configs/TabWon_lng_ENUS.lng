# ----------------------------------------------------------------------
# STATISTICS (Ø)
# ----------------------------------------------------------------------
[estatistica]
TX_MEDIA_ARITMETICA                      = "Arithmetic mean"
TX_MEDIA                                 = "Mean"
TX_SOMA_OS_VALORES_DAS_COLUNAS           = "Adds the values of the selected columns in each row and divides by the number of columns. It is the “typical value” of the row when there are no very discrepant values."
TX_MEDIA_PONDERADA                       = "Weighted mean"
TX_COMO_A_MEDIA_MAS_CADA                 = "Like the mean, but each column has a weight (importance). With weights 1; 2; 1 the second column counts double. Enter one weight per column, in the same order they were selected."
TX_MEDIA_GEOMETRICA                      = "Geometric mean"
TX_MULTIPLICA_OS_VALORES_E_TIRA          = "Multiplies the values and takes the n-th root. Suitable for growth rates, indexes and percent changes. Only works with values greater than zero (rows with zero or negative stay empty)."
TX_MEDIA_HARMONICA                       = "Harmonic mean"
TX_INVERSO_DA_MEDIA_DOS_INVERSOS         = "Inverse of the mean of the inverses. Suitable for averaging ratios (cost per unit, speed). Only values greater than zero. It is always ≤ geometric mean ≤ arithmetic mean."
TX_MEDIA_APARADA                         = "Trimmed mean"
TX_DESCARTA_UMA_PORCENTAGEM_DOS_MENORES  = "Drops a percentage of the smallest and largest values of each row and averages the rest. Reduces the effect of extreme values. With 10% and 10 columns, it removes the smallest and the largest value."
TX_MEDIA_DOS_EXTREMOS                    = "Midrange"
TX_MINIMO_MAXIMO_2_TAMBEM_CHAMADA        = "(Minimum + maximum) ÷ 2, also called midrange. Simple and fast, but very sensitive to extreme values."
TX_TRIMEDIA                              = "Trimean"
TX_TRIMEDIA_DE_TUKEY_Q1_2                = "Tukey's trimean: (Q1 + 2 × Median + Q3) ÷ 4. Combines the median with the quartiles; robust to extremes and summarizes the row better than the median alone."
TX_MEDIANA                               = "Median"
TX_VALOR_DO_MEIO_QUANDO_OS               = "Middle value when the row values are sorted (with an even count, the mean of the two middle ones). Half the values are below and half above; not affected by extremes."
TX_MODA                                  = "Mode"
TX_VALOR_QUE_MAIS_SE_REPETE              = "Most frequent value among the row's columns. If no value repeats, the cell stays empty; if tied, shows the smallest."
TX_QUARTIS                               = "Quartiles"
TX_QUARTIL                               = "Quartile"
TX_DIVIDEM_OS_VALORES_ORDENADOS_EM       = "Split the sorted values into four equal parts: Q1 leaves 25% below, Q2 is the median (50%) and Q3 leaves 75% below. They show where most values are concentrated."
TX_PERCENTIS                             = "Percentiles"
TX_PERCENTIL                             = "Percentile"
TX_O_PERCENTIL_P_E_O                     = "Percentile P is the value below which P% of the row values fall. E.g.: P90 is the value only 10% exceed. Calculated with linear interpolation between the sorted values."
TX_INTERVALO_INTERQUARTIL                = "Interquartile range"
TX_Q3_Q1_A_FAIXA_ONDE                    = "Q3 − Q1: the range holding the central 50% of the values. A robust measure of spread; values more than 1.5 × IQR beyond the quartiles are usually considered outliers."
TX_DESVIO_PADRAO                         = "Standard deviation"
TX_QUANTO_EM_MEDIA_OS_VALORES            = "How far, on average, the values are from the mean, in the same unit as the data. Use “sample” (n − 1) when the columns are a sample and “population” (n) when they are all possible values."
TX_VARIANCIA                             = "Variance"
TX_MEDIA_DOS_QUADRADOS_DOS_DESVIOS       = "Mean of the squared deviations from the mean (the standard deviation squared). Basis of many statistical tests; its unit is squared, so it is less intuitive than the standard deviation."
TX_COEFICIENTE_DE_VARIACAO               = "Coefficient of variation"
TX_CV                                    = "CV (%)"
TX_DESVIO_PADRAO_MEDIA_100_COMPARA       = "Standard deviation ÷ mean × 100. Compares the variability of rows with very different means. Common reference: up to 15% low, 15% to 30% medium and above 30% high spread."
TX_INTERVALOS_DE_CONFIANCA               = "Confidence intervals"
TX_FAIXA_QUE_COM_O_NIVEL                 = "Range that, at the chosen confidence level, should contain the true value. “Mean of the columns” uses the t distribution with the row's columns as a sample. “Proportion A ÷ B” (Wilson method) is suited for rates: A = cases, B = total. Creates two columns: lower and upper limit."
TX_CORRELACAO                            = "Correlation"
TX_MEDE_O_QUANTO_DUAS_COLUNAS            = "Measures how much two columns vary together across the rows: from −1 (perfect inverse) to +1 (perfect direct); near 0, no relation. Pearson measures linear relation; Spearman uses the order of the values and resists extremes. A p-value below 0.05 indicates significant correlation. Correlation does not prove causation."
TX_REGRESSAO_LINEAR                      = "Linear regression"
TX_PREVISTO                              = "Predicted"
TX_AJUSTA_UMA_RETA_OU_PLANO              = "Fits a line (or plane) that explains the 1st selected column (Y) by the others (X): Y = a + b₁·X₁ + …. Shows the coefficients with p-values and R² (how much of Y's variation is explained, from 0 to 1). Can create columns of predicted values and residuals (Y − predicted)."
TX_TESTE_DE_HIPOTESES                    = "Hypothesis test"
TX_TESTE                                 = "Test"
TX_VERIFICA_SE_UMA_DIFERENCA_PODE        = "Checks whether a difference can be explained by chance alone. If the p-value is lower than α (usually 5%), the difference is statistically significant. Paired t: the same rows measured twice (e.g.: 2025 × 2026). Welch's t: two independent groups. One-sample t: mean of one column × reference value. Chi-square: whether the distribution among columns changes from row to row."
TX_ANALISE_BAYESIANA_TAXAS               = "Bayesian analysis (rates)"
TX_TAXA_BAYESIANA                        = "Bayesian rate"
TX_ESTIMA_A_TAXA_A_B                     = "Estimates the rate A ÷ B of each row by combining the row's data with the pattern of all rows (Beta-Binomial model). Rows with few cases are pulled toward the overall mean, avoiding rates exaggerated by chance — widely used for small municipalities. Creates the Bayesian rate and the credible interval. A = cases (not greater than B); B = total or population."
TX_ESCOLHA_UM_TIPO_DE_CALCULO            = "Choose a calculation type."
TX_ESTE_TESTE_EXIGE_EXATAMENTE_2         = "This test requires exactly 2 columns (A and B)."
TX_O_TESTE_T_DE_UMA                      = "The one-sample t test requires exactly 1 column."
TX_INFORME_O_VALOR_DE_REFERENCIA         = "Enter the reference value."
TX_O_QUI_QUADRADO_EXIGE_AO               = "The chi-square test requires at least 2 columns."
TX_EXIGE_AO_MENOS_COLUNAS_NUMERICAS      = "{1} requires at least {2} numeric columns."
TX_PARA_PROPORCAO_SELECIONE_EXATAMENTE_2 = "For a proportion, select exactly 2 columns: A (cases) and then B (total)."
