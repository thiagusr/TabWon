# TabWon — Language file (EN-US)
# ======================================================================
# This file holds all TabWon interface texts.
# To translate TabWon into another language:
#   1. Copy this file with another name, e.g. TabWon_lng_FRFR.lng
#      (always in the TabWon_configs folder, starting with TabWon_lng_).
#   2. Replace Idioma_nome with the name of the new language.
#   3. Translate ONLY the text between quotes, to the right of the equals sign.
#      Do not change the variable name, to the left of the equals sign.
#   4. Keep the markers {1}, {2}, {3}... : TabWon replaces them with names,
#      numbers or amounts. They may move within the sentence.
#   5. \n breaks the line; \" puts quotes in the text; \\ puts a backslash.
#   6. Emojis and symbols (▶ ✓ ⚙ 📊 ...) can be kept.
#   7. Add the new file to the 'idiomas' list in the [idioma] section of
#      TabWon_configs.ini (or in Advanced settings: Shift + click on ⚙).
# Lines starting with # are comments. The names between [ ] show the screen
# where the text appears. A missing or empty variable shows the original
# Portuguese text. Save the file as UTF-8.
# Prefixes: BT button · LB label · CK checkbox · RB option · GR group
#           HD column heading · AB tab · MN menu · TK window title
#           TT tooltip · MSG message · TX general text
# ======================================================================

[idioma]
Idioma_nome = "English (United States)"
Idioma_versao = "1.00.1"

