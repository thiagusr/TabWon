TX_NORMALIZAR                               = "Normalize"
TX_NORMALIZADO                              = "Normalized"
TX_PADRONIZA_OS_VALORES_DE_UMA              = "Puts the values of one or more columns on the same relative scale, making it easier to compare variables of very different sizes or magnitudes. Creates one column for each chosen column, according to the method."
TX_ABSOLUTO                                 = "Absolute"
TX_VALOR_ABSOLUTO_TRANSFORMA_OS_NUMEROS     = "Absolute value: turns negative numbers into positive (−15 becomes 15) and keeps positives."
TX_INTEIRO                                  = "Integer"
TX_PARTE_INTEIRA_DO_NUMERO_DESCARTANDO      = "Integer part of the number, dropping decimals without rounding (12.87 becomes 12; −3.4 becomes −3)."
TX_ARREDONDAR                               = "Round"
TX_ARREDONDADO                              = "Rounded"
TX_ARREDONDA_OS_VALORES_PARA_O              = "Rounds the values to the chosen number of decimal places (12.876 with 1 place becomes 12.9)."
TX_CALCULAR_INDICADOR                       = "Calculate indicator"
