# TabWon — Archivo de idioma (ES)
# ======================================================================
# Este archivo contiene todos los textos de la interfaz de TabWon.
# Para traducir TabWon a otro idioma:
#   1. Copia este archivo con otro nombre, por ejemplo TabWon_lng_FRFR.lng
#      (siempre en la carpeta TabWon_configs, empezando por TabWon_lng_).
#   2. Cambia Idioma_nome por el nombre del nuevo idioma.
#   3. Traduce SOLO el texto entre comillas, a la derecha del signo igual.
#      No cambies el nombre de la variable, a la izquierda del signo igual.
#   4. Mantén las marcas {1}, {2}, {3}... : TabWon las reemplaza por nombres,
#      números o cantidades. Pueden cambiar de lugar en la frase.
#   5. \n salta de línea; \" pone comillas en el texto; \\ pone una barra.
#   6. Los emojis y símbolos (▶ ✓ ⚙ 📊 ...) pueden mantenerse.
#   7. Incluye el nuevo archivo en la lista 'idiomas' de la sección [idioma]
#      de TabWon_configs.ini (o en Configuración avanzada: Shift + clic en ⚙).
# Las líneas que empiezan con # son comentarios. Los nombres entre [ ] indican
# la pantalla en la que aparece el texto. Una variable ausente o vacía muestra
# el texto original en portugués. Guarda el archivo en UTF-8.
# Prefijos: BT botón · LB etiqueta · CK casilla · RB opción · GR grupo
#           HD encabezado de columna · AB pestaña · MN menú · TK título de ventana
#           TT ayuda (tooltip) · MSG mensaje · TX texto general
# ======================================================================

[idioma]
Idioma_nome = "Español (Latinoamérica)"
Idioma_versao = "1.00.1"

