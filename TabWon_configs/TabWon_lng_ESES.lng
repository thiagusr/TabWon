# ----------------------------------------------------------------------
# ESTADÍSTICA (Ø)
# ----------------------------------------------------------------------
[estatistica]
TX_MEDIA_ARITMETICA                      = "Media aritmética"
TX_MEDIA                                 = "Media"
TX_SOMA_OS_VALORES_DAS_COLUNAS           = "Suma los valores de las columnas seleccionadas en cada fila y divide por la cantidad de columnas. Es el “valor típico” de la fila cuando no hay valores muy discrepantes."
TX_MEDIA_PONDERADA                       = "Media ponderada"
TX_COMO_A_MEDIA_MAS_CADA                 = "Como la media, pero cada columna tiene un peso (importancia). Con pesos 1; 2; 1 la segunda columna vale el doble. Indica un peso por columna, en el mismo orden en que fueron seleccionadas."
TX_MEDIA_GEOMETRICA                      = "Media geométrica"
TX_MULTIPLICA_OS_VALORES_E_TIRA          = "Multiplica los valores y saca la raíz de orden n. Indicada para tasas de crecimiento, índices y variaciones porcentuales. Solo funciona con valores mayores que cero (las filas con cero o negativos quedan vacías)."
TX_MEDIA_HARMONICA                       = "Media armónica"
TX_INVERSO_DA_MEDIA_DOS_INVERSOS         = "Inverso de la media de los inversos. Indicada para medias de razones (costo por unidad, velocidad). Solo con valores mayores que cero. Siempre es ≤ media geométrica ≤ media aritmética."
TX_MEDIA_APARADA                         = "Media recortada"
TX_DESCARTA_UMA_PORCENTAGEM_DOS_MENORES  = "Descarta un porcentaje de los menores y mayores valores de cada fila y calcula la media del resto. Reduce el efecto de los valores extremos. Con 10% y 10 columnas, retira el menor y el mayor valor."
TX_MEDIA_DOS_EXTREMOS                    = "Media de los extremos"
TX_MINIMO_MAXIMO_2_TAMBEM_CHAMADA        = "(Mínimo + máximo) ÷ 2, también llamada rango medio. Simple y rápida, pero muy sensible a los valores extremos."
TX_TRIMEDIA                              = "Trimedia"
TX_TRIMEDIA_DE_TUKEY_Q1_2                = "Trimedia de Tukey: (Q1 + 2 × Mediana + Q3) ÷ 4. Combina la mediana con los cuartiles; es robusta a los extremos y resume mejor la fila que la mediana sola."
TX_MEDIANA                               = "Mediana"
TX_VALOR_DO_MEIO_QUANDO_OS               = "Valor del medio cuando los valores de la fila se ordenan (con cantidad par, la media de los dos del medio). La mitad queda por debajo y la mitad por encima; no se ve afectada por los extremos."
TX_MODA                                  = "Moda"
TX_VALOR_QUE_MAIS_SE_REPETE              = "Valor que más se repite entre las columnas de la fila. Si ningún valor se repite, la celda queda vacía; si hay empate, muestra el menor."
TX_QUARTIS                               = "Cuartiles"
TX_QUARTIL                               = "Cuartil"
TX_DIVIDEM_OS_VALORES_ORDENADOS_EM       = "Dividen los valores ordenados en cuatro partes iguales: Q1 deja el 25% por debajo, Q2 es la mediana (50%) y Q3 deja el 75% por debajo. Muestran dónde se concentra la mayor parte de los valores."
TX_PERCENTIS                             = "Percentiles"
TX_PERCENTIL                             = "Percentil"
TX_O_PERCENTIL_P_E_O                     = "El percentil P es el valor por debajo del cual queda el P% de los valores de la fila. Ej.: P90 es el valor que solo el 10% supera. Calculado con interpolación lineal entre los valores ordenados."
TX_INTERVALO_INTERQUARTIL                = "Rango intercuartílico"
TX_Q3_Q1_A_FAIXA_ONDE                    = "Q3 − Q1: el rango donde está el 50% central de los valores. Medida de dispersión robusta; valores a más de 1,5 × RIC más allá de los cuartiles suelen considerarse atípicos."
TX_DESVIO_PADRAO                         = "Desviación estándar"
TX_QUANTO_EM_MEDIA_OS_VALORES            = "Cuánto, en promedio, se alejan los valores de la media, en la misma unidad de los datos. Usa “muestral” (n − 1) cuando las columnas son una muestra y “poblacional” (n) cuando son todos los valores posibles."
TX_VARIANCIA                             = "Varianza"
TX_MEDIA_DOS_QUADRADOS_DOS_DESVIOS       = "Media de los cuadrados de las desviaciones respecto de la media (la desviación estándar al cuadrado). Base de muchas pruebas estadísticas; la unidad queda al cuadrado, por eso es menos intuitiva que la desviación estándar."
TX_COEFICIENTE_DE_VARIACAO               = "Coeficiente de variación"
TX_CV                                    = "CV (%)"
TX_DESVIO_PADRAO_MEDIA_100_COMPARA       = "Desviación estándar ÷ media × 100. Compara la variabilidad de filas con medias muy diferentes. Referencia común: hasta 15% baja, de 15% a 30% media y por encima de 30% alta dispersión."
TX_INTERVALOS_DE_CONFIANCA               = "Intervalos de confianza"
TX_FAIXA_QUE_COM_O_NIVEL                 = "Rango que, con el nivel de confianza elegido, debe contener el valor verdadero. “Media de las columnas” usa la distribución t con las columnas de la fila como muestra. “Proporción A ÷ B” (método de Wilson) es el indicado para tasas: A = casos, B = total. Crea dos columnas: límite inferior y superior."
TX_CORRELACAO                            = "Correlación"
TX_MEDE_O_QUANTO_DUAS_COLUNAS            = "Mide cuánto varían juntas dos columnas a lo largo de las filas: de −1 (relación inversa perfecta) a +1 (directa perfecta); cerca de 0, sin relación. Pearson mide relación lineal; Spearman usa el orden de los valores y resiste a los extremos. Un valor p menor que 0,05 indica correlación significativa. La correlación no prueba causalidad."
TX_REGRESSAO_LINEAR                      = "Regresión lineal"
TX_PREVISTO                              = "Previsto"
TX_AJUSTA_UMA_RETA_OU_PLANO              = "Ajusta una recta (o plano) que explica la 1.ª columna seleccionada (Y) por las demás (X): Y = a + b₁·X₁ + …. Muestra los coeficientes con valor p y el R² (cuánto de la variación de Y se explica, de 0 a 1). Puede crear las columnas de valores previstos y de residuos (Y − previsto)."
TX_TESTE_DE_HIPOTESES                    = "Prueba de hipótesis"
TX_TESTE                                 = "Prueba"
TX_VERIFICA_SE_UMA_DIFERENCA_PODE        = "Verifica si una diferencia puede explicarse solo por el azar. Si el valor p es menor que α (en general 5%), la diferencia es estadísticamente significativa. t pareada: las mismas filas medidas dos veces (ej.: 2025 × 2026). t de Welch: dos grupos independientes. t de una muestra: media de una columna × valor de referencia. Chi-cuadrado: si la distribución entre las columnas cambia de una fila a otra."
TX_ANALISE_BAYESIANA_TAXAS               = "Análisis bayesiano (tasas)"
TX_TAXA_BAYESIANA                        = "Tasa bayesiana"
TX_ESTIMA_A_TAXA_A_B                     = "Estima la tasa A ÷ B de cada fila combinando el dato de la fila con el patrón de todas las filas (modelo Beta-Binomial). Las filas con pocos casos se acercan a la media general, evitando tasas exageradas por azar — muy usado para municipios pequeños. Crea la tasa bayesiana y el intervalo de credibilidad. A = casos (no mayor que B); B = total o población."
TX_ESCOLHA_UM_TIPO_DE_CALCULO            = "Elige un tipo de cálculo."
TX_ESTE_TESTE_EXIGE_EXATAMENTE_2         = "Esta prueba exige exactamente 2 columnas (A y B)."
TX_O_TESTE_T_DE_UMA                      = "La prueba t de una muestra exige exactamente 1 columna."
TX_INFORME_O_VALOR_DE_REFERENCIA         = "Indica el valor de referencia."
TX_O_QUI_QUADRADO_EXIGE_AO               = "El chi-cuadrado exige al menos 2 columnas."
