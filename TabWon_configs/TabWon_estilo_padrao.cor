Padrão
# As cores atuais do TabWon, com um modo escuro compatível.
# Formato: nome_da_cor = R,G,B do modo claro ; R,G,B do modo escuro
# Linhas iniciadas por # são comentários. Altere os números para personalizar.


[janela]
fundo                = 245,245,245 ;  32, 33, 36    # Fundo principal das telas
fundo_sistema        = 240,240,240 ;  41, 42, 45    # Fundo padrão de janelas e botões sem cor própria
