# TabWon — Arquivo de idioma (PT-BR)
# ======================================================================
# Este arquivo contém todos os textos da interface do TabWon.
# Para traduzir o TabWon para outro idioma:
#   1. Copie este arquivo com outro nome, por exemplo TabWon_lng_FRFR.lng
#      (sempre na pasta TabWon_configs, começando por TabWon_lng_).
#   2. Troque Idioma_nome pelo nome do novo idioma.
#   3. Traduza SOMENTE o texto entre aspas, à direita do sinal de igual.
#      Não altere o nome da variável, à esquerda do sinal de igual.
#   4. Mantenha as marcas {1}, {2}, {3}... : elas são trocadas pelo TabWon
#      por nomes, números ou quantidades. Podem mudar de lugar na frase.
#   5. \n quebra a linha; \" coloca aspas no texto; \\ coloca uma barra.
#   6. Emojis e símbolos (▶ ✓ ⚙ 📊 ...) podem ser mantidos.
#   7. Inclua o novo arquivo na lista 'idiomas' da seção [idioma] do
#      TabWon_configs.ini (ou em Configurações avançadas: Shift + clique na ⚙).
# Linhas iniciadas por # são comentários. Os nomes entre [ ] indicam a tela
# em que o texto aparece. Uma variável ausente ou vazia mostra o texto original
# em português. Salve o arquivo em UTF-8.
# Prefixos: BT botão · LB rótulo · CK caixa de marcar · RB opção · GR grupo
#           HD cabeçalho de coluna · AB aba · MN menu · TK título de janela
#           TT dica (tooltip) · MSG mensagem · TX texto geral
# ======================================================================

[idioma]
Idioma_nome = "Português (Brasil)"
Idioma_versao = "1.00.2"

