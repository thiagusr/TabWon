# ----------------------------------------------------------------------
# ESTATÍSTICA (Ø)
# ----------------------------------------------------------------------
[estatistica]
TX_MEDIA_ARITMETICA                      = "Média aritmética"
TX_MEDIA                                 = "Média"
TX_SOMA_OS_VALORES_DAS_COLUNAS           = "Soma os valores das colunas selecionadas em cada linha e divide pela quantidade de colunas. É o “valor típico” da linha quando não há valores muito discrepantes."
TX_MEDIA_PONDERADA                       = "Média ponderada"
TX_COMO_A_MEDIA_MAS_CADA                 = "Como a média, mas cada coluna tem um peso (importância). Com pesos 1; 2; 1 a segunda coluna vale o dobro. Informe um peso para cada coluna, na mesma ordem em que foram selecionadas."
TX_MEDIA_GEOMETRICA                      = "Média geométrica"
TX_MULTIPLICA_OS_VALORES_E_TIRA          = "Multiplica os valores e tira a raiz de ordem n. Indicada para taxas de crescimento, índices e variações percentuais. Só funciona com valores maiores que zero (linhas com zero ou negativo ficam vazias)."
TX_MEDIA_HARMONICA                       = "Média harmônica"
TX_INVERSO_DA_MEDIA_DOS_INVERSOS         = "Inverso da média dos inversos. Indicada para médias de razões (custo por unidade, velocidade). Só com valores maiores que zero. É sempre ≤ média geométrica ≤ média aritmética."
TX_MEDIA_APARADA                         = "Média aparada"
TX_DESCARTA_UMA_PORCENTAGEM_DOS_MENORES  = "Descarta uma porcentagem dos menores e dos maiores valores de cada linha e calcula a média do resto. Reduz o efeito de valores extremos. Com 10% e 10 colunas, retira o menor e o maior valor."
TX_MEDIA_DOS_EXTREMOS                    = "Média dos extremos"
TX_MINIMO_MAXIMO_2_TAMBEM_CHAMADA        = "(Mínimo + máximo) ÷ 2, também chamada de meio-amplitude. Simples e rápida, mas muito sensível a valores extremos."
TX_TRIMEDIA                              = "Trimédia"
TX_TRIMEDIA_DE_TUKEY_Q1_2                = "Trimédia de Tukey: (Q1 + 2 × Mediana + Q3) ÷ 4. Combina a mediana com os quartis; é robusta a extremos e resume melhor a linha do que a mediana sozinha."
TX_MEDIANA                               = "Mediana"
TX_VALOR_DO_MEIO_QUANDO_OS               = "Valor do meio quando os valores da linha são colocados em ordem (com quantidade par, a média dos dois do meio). Metade dos valores fica abaixo e metade acima; não é afetada por extremos."
TX_MODA                                  = "Moda"
TX_VALOR_QUE_MAIS_SE_REPETE              = "Valor que mais se repete entre as colunas da linha. Se nenhum valor se repete, a célula fica vazia; havendo empate, mostra o menor."
TX_QUARTIS                               = "Quartis"
TX_QUARTIL                               = "Quartil"
TX_DIVIDEM_OS_VALORES_ORDENADOS_EM       = "Dividem os valores ordenados em quatro partes iguais: Q1 deixa 25% abaixo, Q2 é a mediana (50%) e Q3 deixa 75% abaixo. Mostram onde se concentra a maior parte dos valores."
TX_PERCENTIS                             = "Percentis"
TX_PERCENTIL                             = "Percentil"
TX_O_PERCENTIL_P_E_O                     = "O percentil P é o valor abaixo do qual ficam P% dos valores da linha. Ex.: P90 é o valor que só 10% superam. Calculado com interpolação linear entre os valores ordenados."
TX_INTERVALO_INTERQUARTIL                = "Intervalo interquartil"
TX_Q3_Q1_A_FAIXA_ONDE                    = "Q3 − Q1: a faixa onde estão os 50% centrais dos valores. Medida de dispersão robusta; valores a mais de 1,5 × IIQ além dos quartis costumam ser considerados atípicos."
TX_DESVIO_PADRAO                         = "Desvio padrão"
TX_QUANTO_EM_MEDIA_OS_VALORES            = "Quanto, em média, os valores se afastam da média, na mesma unidade dos dados. Use “amostral” (n − 1) quando as colunas são uma amostra e “populacional” (n) quando são todos os valores possíveis."
TX_VARIANCIA                             = "Variância"
TX_MEDIA_DOS_QUADRADOS_DOS_DESVIOS       = "Média dos quadrados dos desvios em relação à média (o desvio padrão ao quadrado). Base de muitos testes estatísticos; a unidade fica ao quadrado, por isso é menos intuitiva que o desvio padrão."
TX_COEFICIENTE_DE_VARIACAO               = "Coeficiente de variação"
TX_CV                                    = "CV (%)"
TX_DESVIO_PADRAO_MEDIA_100_COMPARA       = "Desvio padrão ÷ média × 100. Compara a variabilidade de linhas com médias muito diferentes. Referência comum: até 15% baixa, de 15% a 30% média e acima de 30% alta dispersão."
TX_INTERVALOS_DE_CONFIANCA               = "Intervalos de confiança"
TX_FAIXA_QUE_COM_O_NIVEL                 = "Faixa que, com o nível de confiança escolhido, deve conter o valor verdadeiro. “Média das colunas” usa a distribuição t com as colunas da linha como amostra. “Proporção A ÷ B” (método de Wilson) é o indicado para taxas: A = casos, B = total. Cria duas colunas: limite inferior e superior."
TX_CORRELACAO                            = "Correlação"
TX_MEDE_O_QUANTO_DUAS_COLUNAS            = "Mede o quanto duas colunas variam juntas ao longo das linhas: de −1 (relação inversa perfeita) a +1 (direta perfeita); perto de 0, sem relação. Pearson mede relação linear; Spearman usa a ordem dos valores e resiste a extremos. Valor-p abaixo de 0,05 indica correlação significativa. Correlação não prova causa."
TX_REGRESSAO_LINEAR                      = "Regressão linear"
TX_PREVISTO                              = "Previsto"
TX_AJUSTA_UMA_RETA_OU_PLANO              = "Ajusta uma reta (ou plano) que explica a 1ª coluna selecionada (Y) pelas demais (X): Y = a + b₁·X₁ + …. Mostra os coeficientes com valor-p e o R² (quanto da variação de Y é explicada, de 0 a 1). Pode criar as colunas de valores previstos e de resíduos (Y − previsto)."
TX_TESTE_DE_HIPOTESES                    = "Teste de hipóteses"
TX_TESTE                                 = "Teste"
TX_VERIFICA_SE_UMA_DIFERENCA_PODE        = "Verifica se uma diferença pode ser explicada só pelo acaso. Se o valor-p for menor que α (em geral 5%), a diferença é estatisticamente significativa. t pareado: as mesmas linhas medidas duas vezes (ex.: 2025 × 2026). t de Welch: dois grupos independentes. t de uma amostra: média de uma coluna × valor de referência. Qui-quadrado: se a distribuição entre as colunas muda de uma linha para outra."
TX_ANALISE_BAYESIANA_TAXAS               = "Análise bayesiana (taxas)"
TX_TAXA_BAYESIANA                        = "Taxa bayesiana"
TX_ESTIMA_A_TAXA_A_B                     = "Estima a taxa A ÷ B de cada linha combinando o dado da linha com o padrão de todas as linhas (modelo Beta-Binomial). Linhas com poucos casos são aproximadas da média geral, evitando taxas exageradas por acaso — muito usado para municípios pequenos. Cria a taxa bayesiana e o intervalo de credibilidade. A = casos (não maior que B); B = total ou população."
TX_ESCOLHA_UM_TIPO_DE_CALCULO            = "Escolha um tipo de cálculo."
TX_ESTE_TESTE_EXIGE_EXATAMENTE_2         = "Este teste exige exatamente 2 colunas (A e B)."
